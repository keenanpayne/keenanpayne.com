{
  "name": "keenanpayne",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "description": "The personal website for Keenan Payne.",
  "author": {
    "name": "Keenan Payne",
    "email": "contact@keenanpayne.com",
    "url": "https://keenanpayne.com/"
  },
  "homepage": "https://keenanpayne.com",
  "repository": {
    "type": "git",
    "url": "git://github.com/keenanpayne/keenanpayne.com.git"
  },
  "bugs": {
    "url": "https://github.com/keenanpayne/keenanpayne.com/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "serve:prod": "npm run build && npm run start",
    "typecheck": "react-router typegen && tsc",
    "clean": "rm -rf build .react-router",
    "clean:deps": "rm -rf node_modules package-lock.json",
    "clean:all": "npm run clean && npm run clean:deps",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"app/**/*.css\"",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "lint:js:fix": "eslint . --fix",
    "lint:css:fix": "stylelint \"app/**/*.css\" --fix",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "validate": "npm run typecheck && npm run lint && npm run check:format",
    "fix": "npm run lint:fix && npm run format",
    "audit": "npm audit && npm outdated",
    "audit:fix": "npm audit fix && npm update",
    "size": "du -h build/ | sort -hr",
    "analyze:testimonials": "node scripts/analyze-testimonials.ts",
    "lab:new": "node scripts/new-direction.ts"
  },
  "dependencies": {
    "@netlify/vite-plugin-react-router": "^4.0.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "isbot": "^5.2.2",
    "js-yaml": "^4.3.2",
    "luxon": "^3.7.2",
    "markdown-it": "^14.3.2",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0",
    "node-html-parser": "^9.0.4",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/luxon": "^3.7.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "postcss-custom-media": "^12.0.3",
    "postcss-media-minmax": "^5.0.0",
    "postcss-mixins": "^12.1.2",
    "postcss-nested": "^8.0.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  },
  "volta": {
    "node": "24.21.0"
  }
}
